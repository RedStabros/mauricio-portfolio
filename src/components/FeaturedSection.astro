---
import { PROFILE, UI_COPY } from '../data/profile';

// Highlighted production projects fed from src/data/profile.ts.
// The first project uses the elevated surface token to anchor the top of the feed.
---

<section id="featured" data-section-id="featured" class="scroll-mt-10 space-y-6">
  <h2 class="text-xl font-semibold tracking-tight text-text-primary">
    <span data-lang="es">{UI_COPY.es.sections.featuredTitle}</span>
    <span data-lang="en">{UI_COPY.en.sections.featuredTitle}</span>
  </h2>

  <div class="space-y-6">
    {
      PROFILE.featuredProjects.map((project, index) => (
        <article
          class:list={[
            'rounded-md border transition-colors duration-150',
            index === 0
              ? 'border-border bg-surface p-6 hover:border-border-hover sm:p-7'
              : 'border-border bg-bg-base p-6 hover:border-border-hover',
          ]}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class:list={['font-semibold tracking-tight text-text-primary', index === 0 ? 'text-lg' : 'text-base']}>
                  {project.name}
                </h3>
                {project.status === 'production' ? (
                  <span class="inline-flex items-center gap-1.5 rounded border border-accent-border bg-accent-subtle px-2 py-0.5 font-mono text-[11px] text-accent">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent-secondary" aria-hidden="true" />
                    <span data-lang="es">{UI_COPY.es.badges.production}</span>
                    <span data-lang="en">{UI_COPY.en.badges.production}</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center rounded border border-border bg-surface px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                    <span data-lang="es">{UI_COPY.es.badges.enterprise}</span>
                    <span data-lang="en">{UI_COPY.en.badges.enterprise}</span>
                  </span>
                )}
                {'nonProfit' in project && project.nonProfit && (
                  <span class="inline-flex items-center rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                    <span data-lang="es">{UI_COPY.es.badges.nonProfit}</span>
                    <span data-lang="en">{UI_COPY.en.badges.nonProfit}</span>
                  </span>
                )}
              </div>
              <p class="text-xs text-text-secondary">
                <span data-lang="es">{project.role.es}</span>
                <span data-lang="en">{project.role.en}</span>
              </p>
            </div>

            <span class="font-mono text-xs text-text-muted tabular-nums">
              <span data-lang="es">{project.period.es}</span>
              <span data-lang="en">{project.period.en}</span>
            </span>
          </div>

          {'badges' in project && project.badges && project.badges.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {project.badges.map((badge) => (
                <li class="rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                  <span data-lang="es">{badge.es}</span>
                  <span data-lang="en">{badge.en}</span>
                </li>
              ))}
            </ul>
          )}

          <p class="mt-4 max-w-[68ch] text-sm leading-relaxed text-text-secondary">
            <span data-lang="es">{project.summary.es}</span>
            <span data-lang="en">{project.summary.en}</span>
          </p>

          {'metrics' in project && project.metrics && project.metrics.length > 0 && (
            <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border/60 pt-3 font-mono text-xs tabular-nums">
              {project.metrics.map((metric) => (
                <li class="inline-flex items-baseline gap-1.5">
                  <span class="font-medium text-text-primary">{metric.value}</span>
                  <span class="text-text-muted">
                    <span data-lang="es">{metric.label.es}</span>
                    <span data-lang="en">{metric.label.en}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}

          <ul class="mt-4 divide-y divide-border/60 border-t border-border/60 text-xs leading-relaxed text-text-secondary">
            {project.highlights.es.map((item, idx) => (
              <li class="py-2.5">
                <span data-lang="es">{item}</span>
                <span data-lang="en">{project.highlights.en[idx]}</span>
              </li>
            ))}
          </ul>

          {'appCatalog' in project && project.appCatalog && (
            <details class="group/catalog mt-3 rounded border border-border bg-bg-base">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-mono text-xs text-text-primary transition-colors duration-150 hover:text-accent [&::-webkit-details-marker]:hidden">
                <div class="flex min-w-0 flex-wrap items-center gap-3">
                  <div class="flex shrink-0 items-center -space-x-1.5" aria-hidden="true">
                    {project.appCatalog.groups.slice(0, 3).flatMap((g) => g.apps.slice(0, 2)).map((previewApp) => (
                      <img
                        src={previewApp.icon}
                        alt=""
                        width="22"
                        height="22"
                        loading="lazy"
                        decoding="async"
                        class="h-[22px] w-[22px] rounded-sm border border-border bg-surface object-cover"
                      />
                    ))}
                  </div>
                  <span class="min-w-0">
                    <span data-lang="es">{project.appCatalog.triggerLabel.es}</span>
                    <span data-lang="en">{project.appCatalog.triggerLabel.en}</span>
                  </span>
                </div>
                <svg
                  class="h-4 w-4 shrink-0 text-text-muted transition-transform duration-150 group-open/catalog:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="divide-y divide-border border-t border-border px-4">
                {project.appCatalog.groups.map((group) => (
                  <div class="py-4">
                    <h4 class="mb-2.5 flex items-center gap-2 font-mono text-[11px] font-medium tracking-wider text-text-muted uppercase">
                      <span
                        class="h-2 w-2 rounded-full"
                        style={`background-color: ${group.accentDot}`}
                        aria-hidden="true"
                      />
                      <span data-lang="es">{group.category.es}</span>
                      <span data-lang="en">{group.category.en}</span>
                    </h4>
                    <ul class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                      {group.apps.map((app) => (
                        <li class="flex items-start gap-3 rounded border border-border/70 bg-surface p-3">
                          <img
                            src={app.icon}
                            alt={app.name}
                            width="36"
                            height="36"
                            loading="lazy"
                            decoding="async"
                            class="h-9 w-9 shrink-0 rounded border border-border bg-bg-base object-cover"
                          />
                          <div class="min-w-0">
                            <p class="font-mono text-xs font-medium text-text-primary">{app.name}</p>
                            <p class="mt-1 text-xs leading-relaxed text-text-secondary">
                              <span data-lang="es">{app.description.es}</span>
                              <span data-lang="en">{app.description.en}</span>
                            </p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          )}

          <div class="mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4">
            <ul class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <li class="rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                  {tech}
                </li>
              ))}
            </ul>

            {project.links.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                {project.links.map((link, linkIdx) => {
                  const isLocalizedHref = typeof link.href !== 'string';
                  const isPrimaryLink = index === 0 && linkIdx === 0;
                  const linkClasses = isPrimaryLink
                    ? 'inline-flex min-h-[34px] items-center gap-1.5 rounded border border-accent-border bg-accent-subtle px-3 py-1 font-mono text-xs font-medium text-accent transition-colors duration-150 hover:border-accent hover:bg-accent hover:text-accent-fg'
                    : 'inline-flex min-h-[34px] items-center gap-1.5 rounded border border-border bg-bg-base px-3 py-1 font-mono text-xs text-text-primary transition-colors duration-150 hover:border-border-hover hover:text-accent';

                  return isLocalizedHref ? (
                    <>
                      <a
                        data-lang="es"
                        href={(link.href as { es: string; en: string }).es}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClasses}
                      >
                        <span>{link.label.es}</span>
                        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path d="M7 17 17 7" />
                          <path d="M7 7h10v10" />
                        </svg>
                      </a>
                      <a
                        data-lang="en"
                        href={(link.href as { es: string; en: string }).en}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClasses}
                      >
                        <span>{link.label.en}</span>
                        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path d="M7 17 17 7" />
                          <path d="M7 7h10v10" />
                        </svg>
                      </a>
                    </>
                  ) : (
                    <a
                      href={link.href as string}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClasses}
                    >
                      <span data-lang="es">{link.label.es}</span>
                      <span data-lang="en">{link.label.en}</span>
                      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M7 17 17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
