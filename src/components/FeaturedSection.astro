---
import { PROFILE, UI_COPY } from '../data/profile';

// Highlighted production projects fed from src/data/profile.ts.
// The first project uses the elevated surface token to anchor the top of the feed.
---

<section id="featured" data-section-id="featured" class="scroll-mt-10 space-y-6">
  <h2 class="text-xl font-semibold tracking-tight text-text-primary">
    <span data-lang="es">{UI_COPY.es.sections.featuredTitle}</span>
    <span data-lang="en">{UI_COPY.en.sections.featuredTitle}</span>
  </h2>

  <div class="space-y-6">
    {
      PROFILE.featuredProjects.map((project, index) => (
        <article
          class:list={[
            'rounded-md border transition-colors duration-150',
            index === 0
              ? 'border-border bg-surface p-6 hover:border-border-hover sm:p-7'
              : 'border-border bg-bg-base p-6 hover:border-border-hover',
          ]}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2.5">
                <h3 class:list={['font-semibold tracking-tight text-text-primary', index === 0 ? 'text-lg' : 'text-base']}>
                  {project.name}
                </h3>
                {project.status === 'production' ? (
                  <span class="inline-flex items-center gap-1.5 rounded border border-accent-border bg-accent-subtle px-2 py-0.5 font-mono text-[11px] text-accent">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent-secondary" aria-hidden="true" />
                    <span data-lang="es">{UI_COPY.es.badges.production}</span>
                    <span data-lang="en">{UI_COPY.en.badges.production}</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center rounded border border-border bg-surface px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                    <span data-lang="es">{UI_COPY.es.badges.enterprise}</span>
                    <span data-lang="en">{UI_COPY.en.badges.enterprise}</span>
                  </span>
                )}
                {'nonProfit' in project && project.nonProfit && (
                  <span class="inline-flex items-center rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                    <span data-lang="es">{UI_COPY.es.badges.nonProfit}</span>
                    <span data-lang="en">{UI_COPY.en.badges.nonProfit}</span>
                  </span>
                )}
              </div>
              <p class="text-xs text-text-secondary">
                <span data-lang="es">{project.role.es}</span>
                <span data-lang="en">{project.role.en}</span>
              </p>
            </div>

            <span class="font-mono text-xs text-text-muted tabular-nums">
              <span data-lang="es">{project.period.es}</span>
              <span data-lang="en">{project.period.en}</span>
            </span>
          </div>

          <p class="mt-4 max-w-[68ch] text-sm leading-relaxed text-text-secondary">
            <span data-lang="es">{project.summary.es}</span>
            <span data-lang="en">{project.summary.en}</span>
          </p>

          {'metrics' in project && project.metrics && project.metrics.length > 0 && (
            <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border/60 pt-3 font-mono text-xs tabular-nums">
              {project.metrics.map((metric) => (
                <li class="inline-flex items-baseline gap-1.5">
                  <span class="font-medium text-text-primary">{metric.value}</span>
                  <span class="text-text-muted">
                    <span data-lang="es">{metric.label.es}</span>
                    <span data-lang="en">{metric.label.en}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}

          <ul class="mt-4 divide-y divide-border/60 border-t border-border/60 text-xs leading-relaxed text-text-secondary">
            {project.highlights.es.map((item, idx) => (
              <li class="py-2.5">
                <span data-lang="es">{item}</span>
                <span data-lang="en">{project.highlights.en[idx]}</span>
              </li>
            ))}
          </ul>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4">
            <ul class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <li class="rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                  {tech}
                </li>
              ))}
            </ul>

            {project.links.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[34px] items-center gap-1.5 rounded border border-border bg-bg-base px-3 py-1 font-mono text-xs text-text-primary transition-colors duration-150 hover:border-border-hover hover:text-accent"
                  >
                    <span data-lang="es">{link.label.es}</span>
                    <span data-lang="en">{link.label.en}</span>
                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M7 17 17 7" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
