---
import { UI_COPY } from '../data/profile';

// Live repository feed backed by /api/repos.
// Shows skeleton placeholders while loading, supports visibility filtering,
// and keeps source links hidden for private repositories.
---

<section id="repos" data-section-id="repos" class="scroll-mt-10 space-y-5">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2.5">
        <h2 class="text-xl font-semibold tracking-tight text-text-primary">
          <span data-lang="es">{UI_COPY.es.sections.reposTitle}</span>
          <span data-lang="en">{UI_COPY.en.sections.reposTitle}</span>
        </h2>
        <span
          class="inline-flex items-center gap-1.5 rounded border border-border bg-surface px-2 py-0.5 font-mono text-[11px] text-text-muted"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-accent-secondary" aria-hidden="true"></span>
          <span>/api/repos</span>
        </span>
      </div>
      <p class="font-mono text-xs text-text-muted">
        <span data-lang="es">{UI_COPY.es.sections.reposSubtitle}</span>
        <span data-lang="en">{UI_COPY.en.sections.reposSubtitle}</span>
      </p>
    </div>

    <!-- Visibility Filter Controls -->
    <div
      id="repos-filters"
      class="inline-flex items-center rounded border border-border bg-surface p-0.5 font-mono text-xs"
      role="group"
      aria-label="Filter repositories by visibility"
    >
      <button
        type="button"
        data-repo-filter="all"
        aria-pressed="true"
        class="repo-filter-btn min-h-[32px] cursor-pointer rounded-sm bg-border px-2.5 py-1 text-text-primary transition-colors duration-150"
      >
        <span data-lang="es">{UI_COPY.es.filters.all}</span>
        <span data-lang="en">{UI_COPY.en.filters.all}</span>
        <span data-filter-count="all" class="ml-1 text-text-muted tabular-nums"></span>
      </button>
      <button
        type="button"
        data-repo-filter="public"
        aria-pressed="false"
        class="repo-filter-btn min-h-[32px] cursor-pointer rounded-sm px-2.5 py-1 text-text-muted transition-colors duration-150 hover:text-text-primary"
      >
        <span data-lang="es">{UI_COPY.es.filters.public}</span>
        <span data-lang="en">{UI_COPY.en.filters.public}</span>
        <span data-filter-count="public" class="ml-1 text-text-muted tabular-nums"></span>
      </button>
      <button
        type="button"
        data-repo-filter="private"
        aria-pressed="false"
        class="repo-filter-btn min-h-[32px] cursor-pointer rounded-sm px-2.5 py-1 text-text-muted transition-colors duration-150 hover:text-text-primary"
      >
        <span data-lang="es">{UI_COPY.es.filters.private}</span>
        <span data-lang="en">{UI_COPY.en.filters.private}</span>
        <span data-filter-count="private" class="ml-1 text-text-muted tabular-nums"></span>
      </button>
    </div>
  </header>

  <!-- Screen reader live status region -->
  <p id="repos-live-status" class="sr-only" aria-live="polite"></p>

  <!-- Dev Mock Banner (hidden unless API returns source: "mock") -->
  <div
    id="repos-mock-banner"
    class="hidden rounded border border-border bg-surface px-4 py-2.5 font-mono text-xs text-text-secondary"
    role="status"
  >
    <span data-lang="es">{UI_COPY.es.reposState.mockNotice}</span>
    <span data-lang="en">{UI_COPY.en.reposState.mockNotice}</span>
  </div>

  <!-- Skeleton Loader -->
  <div id="repos-skeleton" class="grid grid-cols-1 gap-4" aria-busy="true" aria-label="Loading repositories">
    {
      [1, 2, 3].map(() => (
        <div class="skeleton-card-scan rounded-md border border-border bg-surface p-5">
          <div class="flex items-center justify-between gap-4">
            <div class="skeleton-bar h-4 w-44 rounded-sm" />
            <div class="skeleton-bar h-5 w-28 rounded-sm" />
          </div>
          <div class="mt-3 space-y-2">
            <div class="skeleton-bar h-3.5 w-full rounded-sm" />
            <div class="skeleton-bar h-3.5 w-3/4 rounded-sm" />
          </div>
          <div class="mt-5 flex items-center justify-between border-t border-border pt-3.5">
            <div class="flex gap-3">
              <div class="skeleton-bar h-3 w-20 rounded-sm" />
              <div class="skeleton-bar h-3 w-16 rounded-sm" />
            </div>
            <div class="skeleton-bar h-3 w-28 rounded-sm" />
          </div>
        </div>
      ))
    }
  </div>

  <!-- Live Repositories Container -->
  <div id="repos-grid" class="hidden grid-cols-1 gap-4"></div>

  <!-- Empty / Error State -->
  <div
    id="repos-feedback"
    class="hidden rounded-md border border-border bg-surface p-6 text-center"
    role="status"
  >
    <p id="repos-feedback-text" class="text-sm text-text-secondary"></p>
    <button
      id="repos-retry-btn"
      type="button"
      class="mt-4 hidden min-h-[36px] cursor-pointer rounded border border-border bg-bg-base px-3.5 py-1.5 font-mono text-xs text-text-primary transition-colors duration-150 hover:border-border-hover"
    >
      <span data-lang="es">{UI_COPY.es.actions.retry}</span>
      <span data-lang="en">{UI_COPY.en.actions.retry}</span>
    </button>
  </div>
</section>

<script>
  import type { ReposApiResponse, SanitizedRepo } from '../types/github';
  import { UI_COPY, type Locale } from '../data/profile';

  type VisibilityFilter = 'all' | 'public' | 'private';

  const skeletonEl = document.getElementById('repos-skeleton');
  const gridEl = document.getElementById('repos-grid');
  const feedbackEl = document.getElementById('repos-feedback');
  const feedbackTextEl = document.getElementById('repos-feedback-text');
  const retryBtn = document.getElementById('repos-retry-btn');
  const mockBannerEl = document.getElementById('repos-mock-banner');
  const liveStatusEl = document.getElementById('repos-live-status');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-repo-filter]');

  let cachedRepos: SanitizedRepo[] | null = null;
  let activeFilter: VisibilityFilter = 'all';
  let lastError = false;

  function getCurrentLocale(): Locale {
    return document.documentElement.dataset.locale === 'en' ? 'en' : 'es';
  }

  // Escape text before building card markup from API responses.
  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  // Validate hex colors on the client as a second layer of protection for inline styles.
  function sanitizeHexColor(value: string): string {
    return /^#[0-9A-Fa-f]{6}$/.test(value.trim()) ? value.trim() : '#A1A1AA';
  }

  // Allow only http and https links so unexpected schemes cannot end up in href attributes.
  function sanitizeHttpUrl(value: string | null): string | null {
    if (!value) return null;
    try {
      const parsed = new URL(value);
      return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.toString() : null;
    } catch {
      return null;
    }
  }

  // Format an ISO timestamp as a short relative label in the active locale.
  function formatRelativeDate(isoDate: string, locale: Locale): string {
    const copy = UI_COPY[locale].reposState;
    const updatedMs = new Date(isoDate).getTime();
    if (Number.isNaN(updatedMs)) return '';

    const diffDays = Math.max(0, Math.floor((Date.now() - updatedMs) / 86_400_000));

    if (diffDays === 0) return `${copy.updatedPrefix} ${copy.today}`;
    if (diffDays === 1) return `${copy.updatedPrefix} ${copy.yesterday}`;
    if (diffDays < 30) return `${copy.updatedPrefix} ${copy.daysAgo.replace('{n}', String(diffDays))}`;

    const diffMonths = Math.floor(diffDays / 30);
    if (diffMonths < 12) {
      return `${copy.updatedPrefix} ${copy.monthsAgo.replace('{n}', String(diffMonths))}`;
    }

    const diffYears = Math.floor(diffDays / 365);
    return `${copy.updatedPrefix} ${copy.yearsAgo.replace('{n}', String(diffYears))}`;
  }

  function updateFilterCounts(repos: SanitizedRepo[]) {
    const publicCount = repos.filter((r) => !r.isPrivate).length;
    const privateCount = repos.filter((r) => r.isPrivate).length;
    const counts: Record<VisibilityFilter, number> = {
      all: repos.length,
      public: publicCount,
      private: privateCount,
    };

    (Object.keys(counts) as VisibilityFilter[]).forEach((key) => {
      const badge = document.querySelector<HTMLElement>(`[data-filter-count="${key}"]`);
      if (badge) badge.textContent = `(${counts[key]})`;
    });
  }

  function syncFilterButtons() {
    filterButtons.forEach((btn) => {
      const isSelected = btn.dataset.repoFilter === activeFilter;
      btn.setAttribute('aria-pressed', String(isSelected));
      if (isSelected) {
        btn.classList.add('bg-border', 'text-text-primary');
        btn.classList.remove('text-text-muted');
      } else {
        btn.classList.remove('bg-border', 'text-text-primary');
        btn.classList.add('text-text-muted');
      }
    });
  }

  function renderRepoCard(repo: SanitizedRepo, locale: Locale): string {
    const copy = UI_COPY[locale];
    const safeName = escapeHtml(repo.name);
    const safeDesc = repo.description ? escapeHtml(repo.description) : '';
    const updatedLabel = formatRelativeDate(repo.updatedAt, locale);

    let badgeHtml: string;
    if (repo.isPrivate) {
      badgeHtml = `<span class="inline-flex shrink-0 items-center gap-1.5 rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
           <svg class="h-3 w-3 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
             <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
             <path d="M7 11V7a5 5 0 0 1 10 0v4" />
           </svg>
           ${escapeHtml(copy.badges.privateProd)}
         </span>`;
    } else if (repo.license?.isOpenSource) {
      badgeHtml = `<span class="inline-flex shrink-0 items-center gap-1.5 rounded border border-accent-border bg-accent-subtle px-2 py-0.5 font-mono text-[11px] text-accent">
           <span class="h-1.5 w-1.5 rounded-full bg-accent-secondary" aria-hidden="true"></span>
           ${escapeHtml(copy.badges.openSource)}
         </span>`;
    } else if (repo.license) {
      // Public repo with a non-OSI / source-available license (e.g. PolyForm Noncommercial).
      badgeHtml = `<span class="inline-flex shrink-0 items-center gap-1.5 rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
           <svg class="h-3 w-3 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
             <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
           </svg>
           ${escapeHtml(copy.badges.sourceAvailable)}
         </span>`;
    } else {
      badgeHtml = `<span class="inline-flex shrink-0 items-center gap-1.5 rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-secondary">
           <span class="h-1.5 w-1.5 rounded-full bg-text-muted" aria-hidden="true"></span>
           ${escapeHtml(copy.badges.publicRepo)}
         </span>`;
    }

    // Never render a source code link for private repositories, and allow only http/https URLs.
    const safeRepoUrl = !repo.isPrivate ? sanitizeHttpUrl(repo.repoUrl) : null;
    const safeDemoUrl = sanitizeHttpUrl(repo.homepageUrl);

    const sourceLinkHtml = safeRepoUrl
      ? `<a href="${escapeHtml(safeRepoUrl)}" target="_blank" rel="noopener noreferrer"
             class="inline-flex min-h-[32px] items-center gap-1.5 rounded border border-border bg-bg-base px-2.5 py-1 font-mono text-xs text-text-secondary transition-colors duration-150 hover:border-border-hover hover:text-text-primary">
             <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
               <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
             </svg>
             ${escapeHtml(copy.actions.sourceCode)}
           </a>`
      : '';

    const demoLinkHtml = safeDemoUrl
      ? `<a href="${escapeHtml(safeDemoUrl)}" target="_blank" rel="noopener noreferrer"
           class="inline-flex min-h-[32px] items-center gap-1.5 rounded border border-accent-border bg-accent-subtle px-2.5 py-1 font-mono text-xs font-medium text-accent transition-colors duration-150 hover:border-accent hover:bg-accent hover:text-accent-fg">
           ${escapeHtml(copy.actions.liveDemo)}
           <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
             <path d="M7 17 17 7" />
             <path d="M7 7h10v10" />
           </svg>
         </a>`
      : '';

    const languagesHtml = repo.languages
      .slice(0, 4)
      .map(
        (lang) =>
          `<span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-secondary">
             <span class="h-2 w-2 rounded-full" style="background-color: ${sanitizeHexColor(lang.color)}" aria-hidden="true"></span>
             ${escapeHtml(lang.name)}
           </span>`
      )
      .join('');

    const topicsHtml =
      repo.topics.length > 0
        ? `<div class="mt-3 flex flex-wrap gap-1.5">
             ${repo.topics
               .slice(0, 4)
               .map(
                 (topic) =>
                   `<span class="rounded border border-border bg-bg-base px-2 py-0.5 font-mono text-[11px] text-text-muted">${escapeHtml(topic)}</span>`
               )
               .join('')}
           </div>`
        : '';

    return `
      <article class="precision-card rounded-md p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h3 class="min-w-0 font-mono text-sm font-medium text-text-primary [overflow-wrap:anywhere]">${safeName}</h3>
          ${badgeHtml}
        </div>
        ${safeDesc ? `<p class="mt-2.5 max-w-[68ch] text-sm leading-relaxed text-text-secondary">${safeDesc}</p>` : ''}
        ${topicsHtml}
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3.5">
          <div class="flex flex-wrap items-center gap-3.5">
            ${languagesHtml}
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="font-mono text-xs text-text-muted tabular-nums">${escapeHtml(updatedLabel)}</span>
            ${sourceLinkHtml}
            ${demoLinkHtml}
          </div>
        </div>
      </article>
    `;
  }

  function renderCurrentState(announce = false) {
    const locale = getCurrentLocale();
    if (!gridEl || !feedbackEl || !feedbackTextEl || !retryBtn) return;

    if (lastError) {
      gridEl.classList.add('hidden');
      feedbackEl.classList.remove('hidden');
      feedbackTextEl.textContent = UI_COPY[locale].reposState.error;
      retryBtn.classList.remove('hidden');
      return;
    }

    if (!cachedRepos) return;

    const filtered = cachedRepos.filter((repo) => {
      if (activeFilter === 'public') return !repo.isPrivate;
      if (activeFilter === 'private') return repo.isPrivate;
      return true;
    });

    if (filtered.length === 0) {
      gridEl.classList.add('hidden');
      feedbackEl.classList.remove('hidden');
      feedbackTextEl.textContent =
        cachedRepos.length === 0 ? UI_COPY[locale].reposState.empty : UI_COPY[locale].reposState.emptyFilter;
      retryBtn.classList.add('hidden');
      return;
    }

    feedbackEl.classList.add('hidden');
    gridEl.innerHTML = filtered.map((repo) => renderRepoCard(repo, locale)).join('');
    gridEl.classList.remove('hidden');
    gridEl.classList.add('grid');

    if (announce && liveStatusEl) {
      liveStatusEl.textContent =
        filtered.length === 1
          ? UI_COPY[locale].reposState.liveAnnouncementSingular
          : UI_COPY[locale].reposState.liveAnnouncement.replace('{n}', String(filtered.length));
    }
  }

  async function loadRepositories() {
    if (!skeletonEl || !gridEl || !feedbackEl) return;

    lastError = false;
    skeletonEl.classList.remove('hidden');
    gridEl.classList.add('hidden');
    feedbackEl.classList.add('hidden');
    mockBannerEl?.classList.add('hidden');

    try {
      const response = await fetch('/api/repos', {
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = (await response.json()) as ReposApiResponse;
      cachedRepos = Array.isArray(data.repos) ? data.repos : [];
      updateFilterCounts(cachedRepos);

      if (data.source === 'mock') {
        mockBannerEl?.classList.remove('hidden');
      }
    } catch {
      lastError = true;
      cachedRepos = null;
    } finally {
      skeletonEl.classList.add('hidden');
      renderCurrentState(true);
    }
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.repoFilter as VisibilityFilter | undefined;
      if (!next || next === activeFilter) return;
      activeFilter = next;
      syncFilterButtons();
      renderCurrentState(true);
    });
  });

  retryBtn?.addEventListener('click', () => {
    void loadRepositories();
  });

  window.addEventListener('portfolio:localechange', () => {
    renderCurrentState(true);
  });

  syncFilterButtons();
  void loadRepositories();
</script>
