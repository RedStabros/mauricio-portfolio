---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import FeaturedSection from '../components/FeaturedSection.astro';
import GitHubProjectsSection from '../components/GitHubProjectsSection.astro';
import StackSection from '../components/StackSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import { PROFILE, UI_COPY } from '../data/profile';

// Main portfolio page: sticky left rail on desktop paired with a scrolling
// content column ordered so shipped production work appears first.
---

<BaseLayout>
  <div class="mx-auto min-h-dvh max-w-[1280px] lg:flex">
    <Sidebar />

    <main id="main-content" class="flex-1 px-6 py-10 sm:px-10 lg:px-14 lg:py-14">
      <div class="mx-auto max-w-3xl space-y-20">
        <FeaturedSection />
        <GitHubProjectsSection />
        <StackSection />
        <ExperienceSection />

        <footer class="border-t border-border pt-8 pb-4 font-mono text-xs text-text-muted">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span>© {new Date().getFullYear()} {PROFILE.shortName} · v1.0.1</span>
            <span class="inline-flex items-center gap-1.5">
              <svg
                class="h-3 w-3 shrink-0 fill-accent text-accent"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
              <span>
                <span data-lang="es">{UI_COPY.es.footer.madeWithLovePrefix}</span>
                <span data-lang="en">{UI_COPY.en.footer.madeWithLovePrefix}</span>
              </span>
              <a
                href="https://github.com/RedStabros"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-accent transition-colors duration-150 hover:text-accent-hover hover:underline"
              >
                RedStabros
              </a>
            </span>
          </div>
        </footer>
      </div>
    </main>
  </div>
</BaseLayout>
